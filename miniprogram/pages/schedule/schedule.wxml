<view class="page">

  <!-- 顶部：今天 + 刷新 -->
  <view class="toolbar">
    <view class="pill pill-date">🕐 {{todayText}}</view>
    <view class="pill pill-refresh" hover-class="pill-hover" bindtap="backToCurrent">↻</view>
  </view>

  <!-- 周次切换：箭头 + 周Picker胶囊 -->
  <view class="toolbar">
    <view class="pill pill-arrow" hover-class="pill-hover" bindtap="prevWeek">‹</view>

    <picker
      class="week-picker"
      mode="selector"
      range="{{weekLabels}}"
      value="{{weekIndex}}"
      bindchange="pickWeek"
    >
      <view class="pill pill-week" hover-class="pill-hover">
        <text>第 {{week}} 周{{isCurrentWeek ? '（本周）' : ''}}</text>
        <text class="pill-caret">⌄</text>
      </view>
    </picker>

    <view class="pill pill-arrow" hover-class="pill-hover" bindtap="nextWeek">›</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="sticker-card">
    <view class="empty"><view class="empty-desc">正在加载课表…</view></view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{error}}" class="sticker-card">
    <view class="empty">
      <view class="empty-icon">⚠️</view>
      <view class="empty-title">加载失败</view>
      <view class="empty-desc">{{error}}</view>
      <button class="btn-primary btn-sticker" bindtap="backToCurrent">重试</button>
    </view>
  </view>

  <block wx:else>

    <!-- 演示数据横幅 -->
    <view wx:if="{{demo}}" class="demo-banner" hover-class="pill-hover" bindtap="goBind">
      <view class="demo-banner-icon">👀</view>
      <view class="demo-banner-body">
        <view class="demo-banner-title">这是示例数据</view>
        <view class="demo-banner-text">还没绑定学校平台，当前是示例课表。点这里去绑定 →</view>
      </view>
    </view>

    <!-- 没课时给个明确出口，而不是一张空网格 -->
    <view wx:if="{{!hasSessions}}" class="sticker-card">
      <view class="empty">
        <view class="empty-icon">🗓️</view>
        <view class="empty-title">这一周没有课</view>
        <view class="empty-desc">
          要么是还没绑定平台，要么是校历配置（campus.term.start-date）和学校对不上。
        </view>
        <button class="btn-primary btn-sticker" bindtap="goBind">去绑定平台</button>
      </view>
    </view>

    <!-- 课表网格本体：虚线格 + 糖果色方块 -->
    <view class="board">
      <view class="head">
        <view class="axis-head"></view>
        <view class="days">
          <view
            wx:for="{{days}}"
            wx:key="dayOfWeek"
            class="day-head {{item.isToday ? 'day-head-today' : ''}}"
          >
            <view class="day-label">{{item.shortLabel}}</view>
            <view class="day-date">{{item.date}}</view>
          </view>
        </view>
      </view>

      <view class="grid" style="height:{{gridHeight}}rpx">
        <view class="axis">
          <view
            wx:for="{{rows}}"
            wx:key="n"
            class="axis-cell"
            style="height:{{rowHeight}}rpx"
          >{{item.n}}</view>
        </view>

        <view class="days">
          <view
            wx:for="{{days}}"
            wx:key="dayOfWeek"
            class="day-col"
          >
            <view
              wx:for="{{item.blocks}}"
              wx:for-item="b"
              wx:key="key"
              class="block block-c{{b.ci}}"
              style="top:{{b.top}}rpx;height:{{b.height}}rpx"
              data-block="{{b}}"
              bindtap="showBlock"
            >
              <view class="block-name">{{b.courseName}}</view>
              <view class="block-loc">{{b.location}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="hint muted">
      课表格子来自「手动导入」或已联调的平台适配器。点方块看详情。
    </view>

  </block>

  <view class="page-bottom-space"></view>
</view>
