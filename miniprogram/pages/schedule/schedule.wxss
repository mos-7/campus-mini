.page {
  padding-top: 24rpx;
}

/* ---------- 周次切换 ---------- */

.weekbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx 20rpx;
}

.weekbar-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #6b5ce7;
  font-size: 48rpx;
  line-height: 68rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(31, 34, 51, 0.06);
}

.weekbar-main {
  text-align: center;
  flex: 1;
}

.weekbar-title {
  font-size: 36rpx;
  font-weight: 700;
}

/* ---------- 周次 chips ---------- */

.chips {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
  display: flex;
}

.chip {
  display: inline-block;
  min-width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6b7b;
  font-size: 26rpx;
  margin-right: 12rpx;
  padding: 0 8rpx;
  /* scroll-x 里必须禁止收缩，否则 20 个周次会被压缩成一条 */
  flex-shrink: 0;
}

.chip-active {
  background: #6b5ce7;
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 演示数据横幅 ---------- */

.demo-banner {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #fff8e8;
  border: 1rpx solid #ffe6b0;
}

.demo-banner-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  line-height: 1.2;
}

.demo-banner-body {
  flex: 1;
  min-width: 0;
}

.demo-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8a6100;
  margin-bottom: 6rpx;
}

.demo-banner-text {
  font-size: 23rpx;
  color: #a37b1a;
  line-height: 1.6;
}

/* ---------- 网格 ---------- */

.grid-card {
  padding: 24rpx 16rpx 16rpx;
  overflow: hidden;
}

.head {
  display: flex;
  align-items: flex-end;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f1f5;
}

.axis-head {
  width: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa0ac;
  flex-shrink: 0;
}

.days {
  display: flex;
  flex: 1;
  min-width: 0;
}

.day-head {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.day-label {
  font-size: 26rpx;
  font-weight: 600;
}

.day-date {
  font-size: 20rpx;
  color: #9aa0ac;
}

.day-head-today .day-label,
.day-head-today .day-date {
  color: #6b5ce7;
}

.grid {
  display: flex;
  position: relative;
}

.axis {
  width: 56rpx;
  flex-shrink: 0;
}

.axis-cell {
  text-align: center;
  font-size: 22rpx;
  color: #b6bac6;
  padding-top: 8rpx;
}

.day-col {
  flex: 1;
  position: relative;
  min-width: 0;
  border-left: 1rpx solid #f7f7fb;
}

.day-col-today {
  background: #faf9ff;
}

/* 课表方块：位置和高度由 JS 按节次算出来 */
.block {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  border-radius: 14rpx;
  background: linear-gradient(150deg, #8b7ef5, #6b5ce7);
  color: #ffffff;
  padding: 10rpx 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.block-name {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-all;
}

.block-loc {
  font-size: 18rpx;
  opacity: 0.85;
  margin-top: 4rpx;
  word-break: break-all;
}

/* ---------- 底部提示 ---------- */

.hint {
  padding: 0 48rpx 24rpx;
  line-height: 1.7;
}
