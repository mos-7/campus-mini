<view class="page">

  <view class="policy-head">
    <view class="policy-title">小粥历 · 隐私政策</view>
    <view class="muted">最后更新：{{updatedAt}}</view>
  </view>

  <view wx:for="{{sections}}" wx:key="title" class="card">
    <view class="section-title">{{item.title}}</view>
    <view
      wx:for="{{item.paragraphs}}"
      wx:for-item="p"
      wx:key="*this"
      class="para"
    >{{p}}</view>
  </view>

  <view class="page-bottom-space"></view>
</view>
