<view class="page">

  <view class="policy-head">
    <view class="policy-title">校园盒子 · 隐私政策</view>
    <view class="muted">最后更新：{{updatedAt}}</view>
  </view>

  <view class="summary">
    <view class="summary-title">一句话概括</view>
    <view class="summary-text">
      我们只用你的微信身份区分账号，用你填写的学校账号读取你自己的课表。
      密码加密存储，只读不写，不卖给任何人。
    </view>
  </view>

  <view wx:for="{{sections}}" wx:key="title" class="card">
    <view class="section-title">{{item.title}}</view>
    <view
      wx:for="{{item.paragraphs}}"
      wx:for-item="p"
      wx:key="*this"
      class="para"
    >{{p}}</view>
  </view>

  <view class="page-bottom-space"></view>
</view>
