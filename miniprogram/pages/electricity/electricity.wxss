.page {
  padding-top: 24rpx;
}

.stage {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 48rpx;
}

.baby {
  width: 360rpx;
  border-radius: 24rpx;
  margin-bottom: 48rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
}

.muted {
  font-size: 26rpx;
  color: #999;
  line-height: 1.8;
}
