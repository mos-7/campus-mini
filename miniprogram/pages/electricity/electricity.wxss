.page {
  padding-top: 24rpx;
}

/* ---------- 当前读数 ---------- */

.now-row {
  display: flex;
  gap: 16rpx;
}

.now-cell {
  flex: 1;
  min-width: 0;
  background: #f7f8fc;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}

.now-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #6b5ce7;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.diff {
  margin-top: 20rpx;
  text-align: center;
}

/* ---------- 录入 ---------- */

.input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.input-cell {
  flex: 1;
  min-width: 0;
}

.input {
  width: 100%;
  background: #f7f8fc;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  margin-top: 12rpx;
}

.why-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

/* ---------- 历史 ---------- */

.rec-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid #f0f1f5;
}

.rec-row:first-of-type {
  border-top: none;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-main {
  font-size: 29rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.rec-del {
  font-size: 20rpx;
  flex-shrink: 0;
  padding-left: 16rpx;
}
