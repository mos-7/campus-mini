<view class="page">

  <!-- 当前状态 -->
  <view wx:if="{{latest}}" class="card">
    <view class="card-head">
      <view class="card-title">当前读数</view>
      <view class="muted">{{latest.timeText}} 录入</view>
    </view>

    <view class="now-row">
      <view wx:if="{{latest.kwh !== ''}}" class="now-cell">
        <view class="now-num">{{latest.kwh}}</view>
        <view class="muted">剩余电量（度）</view>
      </view>
      <view wx:if="{{latest.yuan !== ''}}" class="now-cell">
        <view class="now-num">{{latest.yuan}}</view>
        <view class="muted">剩余金额（元）</view>
      </view>
    </view>

    <view wx:if="{{diff}}" class="diff muted">
      距上次：
      <text wx:if="{{diff.kwh !== undefined}}">{{diff.kwh > 0 ? '+' : ''}}{{diff.kwh}} 度</text>
      <text wx:if="{{diff.yuan !== undefined}}"> · {{diff.yuan > 0 ? '+' : ''}}{{diff.yuan}} 元</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="card">
    <view class="empty">
      <view class="empty-icon">⚡</view>
      <view class="empty-title">还没有记录</view>
      <view class="empty-desc">在别处查到电费数字后，在这里记一笔，随时回看用量变化。</view>
    </view>
  </view>

  <!-- 录入 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">记一笔</view>
    </view>

    <view class="input-row">
      <view class="input-cell">
        <view class="muted">剩余电量（度）</view>
        <input
          class="input"
          type="digit"
          value="{{kwh}}"
          bindinput="onKwh"
          placeholder="如 134.1"
        />
      </view>
      <view class="input-cell">
        <view class="muted">剩余金额（元）</view>
        <input
          class="input"
          type="digit"
          value="{{yuan}}"
          bindinput="onYuan"
          placeholder="如 73.77"
        />
      </view>
    </view>

    <button class="btn-primary" bindtap="save">保存</button>

    <view class="muted why-tip">
      学校电费是建行平台，暂不支持自动查询——查到数字后手动记一笔即可，历史只存在你手机上。
    </view>
  </view>

  <!-- 历史 -->
  <view wx:if="{{records.length}}" class="card">
    <view class="card-head">
      <view class="card-title">历史记录</view>
      <view class="muted">{{records.length}} 条</view>
    </view>

    <view
      wx:for="{{records}}"
      wx:key="id"
      class="rec-row"
      data-id="{{item.id}}"
      bindlongpress="remove"
    >
      <view class="rec-body">
        <view class="rec-main">
          <text wx:if="{{item.kwh !== ''}}">{{item.kwh}} 度</text>
          <text wx:if="{{item.yuan !== ''}}"> · {{item.yuan}} 元</text>
        </view>
        <view class="muted">{{item.timeText}}</view>
      </view>
      <view class="rec-del muted">长按删除</view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
</view>
