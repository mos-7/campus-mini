/* 首页 · 描边贴纸风（与课表页同一套语言）
   依赖 app.wxss 里的 .sticker / .btn-sticker / .tint-* / .demo-banner */

.page {
  padding-top: 24rpx;
}

/* ---------- 顶部问候 ---------- */

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 44rpx 40rpx;
}

.hero-name {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
}

/* 吉祥物头像：贴纸相框 */
.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #ffffff;
  border: 2rpx solid #26263a;
  box-shadow: 4rpx 4rpx 0 rgba(38, 38, 58, 0.85);
  box-sizing: border-box;
}

/* ---------- 通用小件 ---------- */

.sticker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2233;
}

/* 右上角小胶囊链接 */
.link-pill {
  font-size: 24rpx;
  color: #1f2233;
  background: #ffffff;
  border: 2rpx solid #26263a;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.85);
}

.pill-hover {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(38, 38, 58, 0.85);
}

/* 可点行的按压反馈 */
.row-press {
  opacity: 0.7;
}

/* ---------- 今日课程 ---------- */

.today-sub {
  margin-bottom: 20rpx;
}

.session {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx dashed #e3e3ec;
}

.session:first-of-type {
  border-top: none;
}

/* 节次糖果贴片 */
.session-time {
  width: 108rpx;
  text-align: center;
  flex-shrink: 0;
  padding: 14rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #26263a;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.8);
  box-sizing: border-box;
  margin-right: 24rpx;
}

.session-section {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.session-unit {
  font-size: 18rpx;
  opacity: 0.75;
  margin-top: 2rpx;
}

/* 节次贴片按序轮换糖果色（wxml 里 tint-c{{index % 6}}） */
.tint-c0 { background: #e7defc; color: #5546a8; }
.tint-c1 { background: #d9e8fd; color: #2f5fa8; }
.tint-c2 { background: #d3f2e0; color: #1f7a4d; }
.tint-c3 { background: #fdeec2; color: #8a6d1a; }
.tint-c4 { background: #fbdcec; color: #a83e7d; }
.tint-c5 { background: #ffe3cc; color: #a35422; }

.session-body {
  flex: 1;
  min-width: 0;
}

/* ---------- 公告 ---------- */

.notice {
  padding: 16rpx 0;
  border-top: 2rpx dashed #e3e3ec;
}

.notice:first-of-type {
  border-top: none;
}

/* ---------- 快捷入口：糖果贴纸 ---------- */

.quick-grid {
  display: flex;
  gap: 20rpx;
}

.quick-tile {
  flex: 1;
  min-width: 0;
  position: relative;
  border-radius: 18rpx;
  border: 2rpx solid #26263a;
  box-shadow: 4rpx 4rpx 0 rgba(38, 38, 58, 0.85);
  padding: 24rpx;
  box-sizing: border-box;
}

.quick-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 14rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 700;
}

.quick-desc {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}

/* ---------- 开源仓库 ---------- */

.repo {
  margin-top: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.repo-url {
  font-size: 22rpx;
  color: #8a8fa3;
  word-break: break-all;
  line-height: 1.5;
}

.repo-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b4b8c6;
}
