<view class="page">

  <view wx:if="{{loading}}" class="card">
    <view class="empty"><view class="empty-desc">正在加载…</view></view>
  </view>

  <view wx:elif="{{error}}" class="card">
    <view class="empty">
      <view class="empty-icon">⚠️</view>
      <view class="empty-title">加载失败</view>
      <view class="empty-desc">{{error}}</view>
      <button class="btn-primary" bindtap="load">重试</button>
    </view>
  </view>

  <block wx:else>

    <!-- 平台卡片 -->
    <view wx:for="{{cards}}" wx:key="code" class="card">
      <view class="row between">
        <view class="plat-name">{{item.name}}</view>
        <view class="badge {{item.bound ? 'badge-ok' : 'badge-off'}}">{{item.statusText}}</view>
      </view>

      <view class="muted plat-desc">{{item.description}}</view>

      <view class="muted plat-meta">
        <text>{{item.loginModeLabel}}</text>
        <text wx:if="{{item.accountLabel}}"> · {{item.accountLabel}}</text>
        <text wx:if="{{item.lastSyncText}}"> · 上次同步 {{item.lastSyncText}}</text>
      </view>

      <view wx:if="{{item.lastError}}" class="error-text">{{item.lastError}}</view>

      <view class="plat-actions">
        <button
          wx:if="{{!item.bound}}"
          class="btn-primary btn-sm"
          data-card="{{item}}"
          bindtap="openBind"
        >绑定</button>

        <block wx:else>
          <button class="btn-ghost" data-card="{{item}}" bindtap="syncNow">立即同步</button>
          <button class="btn-ghost btn-danger" data-card="{{item}}" bindtap="unbind">解绑</button>
        </block>
      </view>
    </view>

  </block>

  <view class="page-bottom-space"></view>
</view>

<!-- ================= 绑定面板 ================= -->
<view wx:if="{{panelVisible}}" class="mask" bindtap="closePanel">
  <view class="panel" catchtap="noop">
    <view class="row between panel-head">
      <view class="panel-title">绑定 {{activeCard.name}}</view>
      <view class="panel-close" bindtap="closePanel">✕</view>
    </view>

    <!-- 手动导入模式 -->
    <block wx:if="{{isManual}}">
      <view class="muted panel-tip">
        <view>每行一个上课安排，字段用逗号隔开，<text class="strong">顺序随意</text> ——</view>
        <view>程序按内容识别哪个是星期、哪个是节次、哪个是周次。</view>
        <view class="panel-tip-sample">示例：高等数学,张老师,周一,1-2节,1-16周,教三201</view>
      </view>
      <textarea
        class="textarea textarea-tall"
        value="{{formSecret}}"
        bindinput="onSecretInput"
        placeholder="在这里粘贴课表…"
        maxlength="-1"
      />
      <view class="panel-aux">
        <view class="btn-ghost" bindtap="fillSample">填入示例课表</view>
      </view>
    </block>

    <!-- 账号密码 / Token 模式 -->
    <block wx:else>
      <view class="muted panel-tip">{{activeCard.description}}</view>
      <input
        class="input"
        value="{{formUsername}}"
        bindinput="onUsernameInput"
        placeholder="学号 / 账号"
      />
      <textarea
        class="textarea"
        value="{{formSecret}}"
        bindinput="onSecretInput"
        placeholder="密码（或按平台提示粘贴 Token / Cookie）"
        maxlength="-1"
      />
    </block>

    <button
      class="btn-primary panel-submit"
      bindtap="submitBind"
      disabled="{{submitting}}"
    >{{submitting ? '正在校验…' : '确认绑定'}}</button>

    <view class="muted panel-foot">
      凭据会用 AES-GCM 加密后存到你自己的数据库。自己用没问题，
      但如果给别人用，记得在隐私政策里写明这一点。
    </view>
  </view>
</view>

<!-- ================= 同步进度 ================= -->
<view wx:if="{{syncVisible}}" class="mask">
  <view class="sync-box">
    <view class="sync-title">正在同步</view>
    <view class="progress-track">
      <view class="progress-fill" style="width:{{syncProgress}}%"></view>
    </view>
    <view class="muted sync-msg">{{syncProgress}}% · {{syncMessage}}</view>
  </view>
</view>
