<view class="page">

  <view wx:if="{{loading}}" class="sticker">
    <view class="empty"><view class="empty-desc">正在加载…</view></view>
  </view>

  <view wx:elif="{{error}}" class="sticker">
    <view class="empty">
      <view class="empty-icon">⚠️</view>
      <view class="empty-title">加载失败</view>
      <view class="empty-desc">{{error}}</view>
      <button class="btn-primary btn-sticker" hover-class="btn-sticker-hover" bindtap="load">重试</button>
    </view>
  </view>

  <block wx:else>

    <!-- 用户卡片 -->
    <view class="sticker user-card">
      <image class="user-avatar" src="/images/mascot-avatar.jpg" mode="aspectFill" />
      <view class="user-body">
        <view class="row gap">
          <view class="user-name">{{nickname}}</view>
          <view class="user-tag {{boundCount > 0 ? 'user-tag-on' : ''}}">
            {{boundCount > 0 ? '已连接 ' + boundCount + '/' + totalCount : '未绑定平台'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 服务绑定中心：三个平台小部件，点任意一个进绑定管理页 -->
    <view class="sticker">
      <view class="svc-head">
        <view class="svc-icon tint-yellow">📦</view>
        <view class="svc-head-body">
          <view class="svc-title">服务绑定中心</view>
          <view class="muted ellipsis">绑定后自动同步课表，点下方平台去管理</view>
        </view>
        <view class="svc-count">
          <text class="svc-count-num">{{boundCount}}</text> / {{totalCount}} 已连接
        </view>
      </view>

      <view class="svc-row">
        <view
          wx:for="{{cards}}"
          wx:key="code"
          class="svc-widget {{item.bound ? 'svc-on' : ''}}"
          hover-class="svc-widget-hover"
          bindtap="openBindings"
        >
          <view class="svc-widget-head">
            <view class="svc-dot"></view>
            <text class="svc-name">{{item.name}}</text>
          </view>
          <view class="svc-state">{{item.stateText}}</view>
        </view>
      </view>
    </view>

    <!-- 课程与学习管理 -->
    <view class="sticker">
      <view class="sec-title">课程与学习管理</view>

      <view class="setting setting-first" hover-class="row-press" bindtap="openPeriods">
        <view class="setting-icon tint-c0">⏰</view>
        <view class="setting-body">
          <view class="setting-title">作息时刻设置</view>
          <view class="muted">自定义上下课时间与时段预设</view>
        </view>
        <view class="setting-value">{{routineLabel}}</view>
        <view class="setting-arrow">›</view>
      </view>

      <view class="setting" hover-class="row-press" bindtap="toggleAutoSync">
        <view class="setting-icon tint-c1">🔄</view>
        <view class="setting-body">
          <view class="setting-title">课表自动更新</view>
          <view class="muted">打开小程序时，超过一天没同步就在后台静默更新</view>
        </view>
        <view class="setting-value {{autoSyncOn ? 'setting-value-on' : ''}}">
          {{autoSyncOn ? '已开启' : '已关闭'}}
        </view>
        <view class="setting-arrow">›</view>
      </view>
    </view>

    <!-- 支持与反馈 -->
    <view class="sticker">
      <view class="sec-title">支持与反馈</view>

      <view class="setting setting-first" hover-class="row-press" bindtap="privacy">
        <view class="setting-icon tint-c4">🔒</view>
        <view class="setting-body">
          <view class="setting-title">隐私政策</view>
          <view class="muted">收集哪些信息、用来做什么、怎么存</view>
        </view>
        <view class="setting-arrow">›</view>
      </view>

      <view class="setting" hover-class="row-press" bindtap="contact">
        <view class="setting-icon tint-c3">✉️</view>
        <view class="setting-body">
          <view class="setting-title">联系开发者</view>
          <view class="muted">问题反馈、删除数据 · 点此复制邮箱</view>
        </view>
        <view class="setting-arrow">›</view>
      </view>

      <view class="setting" hover-class="row-press" bindtap="about">
        <view class="setting-icon tint-c2">ℹ️</view>
        <view class="setting-body">
          <view class="setting-title">关于小粥历</view>
          <view class="muted">这个项目做什么、不做什么</view>
        </view>
        <view class="setting-arrow">›</view>
      </view>
    </view>

  </block>

  <view class="page-bottom-space"></view>
</view>
