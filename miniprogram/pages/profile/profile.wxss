/* 我的页 · 描边贴纸风（依赖 app.wxss 的 .sticker / .btn-sticker） */

.page {
  padding-top: 24rpx;
}

/* ---------- 用户卡片 ---------- */

.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}

/* 头像：贴纸相框 */
.user-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  background: #ffffff;
  border: 2rpx solid #26263a;
  box-shadow: 4rpx 4rpx 0 rgba(38, 38, 58, 0.85);
  box-sizing: border-box;
}

.user-body {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
}

.user-tag {
  font-size: 22rpx;
  color: #6b6b7b;
  background: #ffffff;
  border: 2rpx solid #26263a;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  box-shadow: 2rpx 2rpx 0 rgba(38, 38, 58, 0.85);
}

.user-tag-on {
  background: #d3f2e0;
  color: #1f7a4d;
}

/* ---------- 服务绑定中心 ---------- */

.svc-head {
  display: flex;
  align-items: center;
}

.svc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx solid #26263a;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.8);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.svc-head-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.svc-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.svc-count {
  flex-shrink: 0;
  background: #ffffff;
  border: 2rpx solid #26263a;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.85);
  color: #1f2233;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.svc-count-num {
  font-size: 30rpx;
  font-weight: 700;
}

/* 三个平台小部件：等宽三列，整体可点 */
.svc-row {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.svc-widget {
  flex: 1;
  min-width: 0;
  background: #f4f5f9;
  border: 2rpx solid #c8ccd8;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 按下去 */
.svc-widget-hover {
  transform: translate(2rpx, 2rpx);
}

.svc-widget-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.svc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c8ccd8;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.svc-name {
  font-size: 24rpx;
  color: #6b6b7b;
}

.svc-state {
  font-size: 20rpx;
  color: #b4b8c6;
  margin-top: 10rpx;
}

/* 已连接：绿色糖果贴纸 */
.svc-on {
  background: #d3f2e0;
  border-color: #26263a;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.85);
}

.svc-on .svc-dot {
  background: #1f7a4d;
}

.svc-on .svc-name {
  color: #1f7a4d;
  font-weight: 600;
}

.svc-on .svc-state {
  color: #1f7a4d;
  opacity: 0.8;
}

/* ---------- 分组标题 ---------- */

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

/* ---------- 设置项 ---------- */

.setting {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-top: 2rpx dashed #e3e3ec;
}

.setting-first {
  border-top: none;
}

.row-press {
  opacity: 0.7;
}

.setting-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  border: 2rpx solid #26263a;
  box-shadow: 3rpx 3rpx 0 rgba(38, 38, 58, 0.8);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 图标糖果色轮换（wxml 里 tint-c0..c5） */
.tint-c0 { background: #e7defc; color: #5546a8; }
.tint-c1 { background: #d9e8fd; color: #2f5fa8; }
.tint-c2 { background: #d3f2e0; color: #1f7a4d; }
.tint-c3 { background: #fdeec2; color: #8a6d1a; }
.tint-c4 { background: #fbdcec; color: #a83e7d; }
.tint-c5 { background: #ffe3cc; color: #a35422; }

.setting-body {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.setting-value {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6b6b7b;
  background: #ffffff;
  border: 2rpx solid #26263a;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  box-shadow: 2rpx 2rpx 0 rgba(38, 38, 58, 0.85);
}

.setting-value-on {
  background: #d3f2e0;
  color: #1f7a4d;
}

.setting-arrow {
  color: #3a3a4a;
  font-size: 40rpx;
  padding-left: 16rpx;
}
