.page {
  padding-top: 24rpx;
}

/* ---------- 用户卡片 ---------- */

.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f1fd;
}

.user-body {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
}

.user-tag {
  font-size: 22rpx;
  color: #9aa0ac;
  background: #f0f1f5;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.user-tag-on {
  color: #6b5ce7;
  background: #f2f1fd;
}

/* ---------- 服务绑定中心 ---------- */

.svc-head {
  display: flex;
  align-items: center;
}

.svc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #f2f1fd;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.svc-head-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.svc-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.svc-count {
  flex-shrink: 0;
  background: #f2f1fd;
  color: #6b5ce7;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
}

.svc-count-num {
  font-size: 32rpx;
  font-weight: 700;
}

/* 三个平台小部件：等宽三列，整体可点 */
.svc-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.svc-widget {
  flex: 1;
  min-width: 0;
  background: #f7f8fc;
  border: 1rpx solid #eef0f6;
  border-radius: 18rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.svc-widget-hover {
  opacity: 0.75;
}

.svc-widget-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.svc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c8ccd8;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.svc-name {
  font-size: 24rpx;
  color: #6b6b7b;
}

.svc-state {
  font-size: 20rpx;
  color: #b4b8c6;
  margin-top: 10rpx;
}

.svc-on {
  background: #f6f5fe;
  border-color: #ddd8fb;
}

.svc-on .svc-dot {
  background: #6b5ce7;
}

.svc-on .svc-name {
  color: #6b5ce7;
  font-weight: 500;
}

.svc-on .svc-state {
  color: #8b7ef5;
}

/* ---------- 分组标题 ---------- */

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* ---------- 设置项 ---------- */

.setting {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f1f5;
}

.setting-first {
  border-top: none;
}

.setting-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #f2f1fd;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tint-blue {
  background: #eef4fe;
}

.tint-green {
  background: #eaf9f1;
}

.setting-body {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.setting-value {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6b6b7b;
  background: #f0f1f5;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.setting-value-on {
  background: #e8f8ef;
  color: #22a06b;
}

.setting-arrow {
  color: #c8ccd8;
  font-size: 40rpx;
  padding-left: 16rpx;
}
